{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "caritas-web",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// エラーログを Cloudflare ダッシュボード(Observability)で確認できるようにする
	// SITE_PASSWORD:開発サイトの合言葉(正式公開時に削除するとゲートが外れる)
	"vars": {
		"SITE_PASSWORD": "caritas",
		// お問い合わせフォーム:通知先アドレス(複数はカンマ区切り)。送信には send_email バインディング CONTACT_MAIL と CONTACT_FROM(Cloudflare DNS のドメインのアドレス)が必要
		"CONTACT_TO": "ueno@respiration-inc.com",
		// Cloudflare Turnstile のサイトキー(公開値)。シークレットキーは Worker のシークレット TURNSTILE_SECRET_KEY
		"TURNSTILE_SITE_KEY": "0x4AAAAAAFbFNepGqqS-iqd7",
		// お問い合わせフォーム:Turnstile を許可するホスト名(カンマ区切り)。正式公開時は本番ドメインを追加する
		"CONTACT_HOSTS": "caritas-web.respiration.workers.dev",
	},
	// お問い合わせフォーム:同じ IP からの送信回数の制限(1 分に 3 回まで)
	"ratelimits": [
		{
			"name": "CONTACT_RL",
			"namespace_id": "1001",
			"simple": { "limit": 3, "period": 60 },
		},
	],
	"observability": {
		"enabled": true,
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "caritas-web",
			"database_id": "33150d7e-2314-404b-9f58-fd75674ed5a0",
		},
	],
	// Astro のセッション用 KV(初回デプロイ時に自動作成されたもの)
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "40a03479b678451188960f6f0c316a0c",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "caritas-web-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
