---
/*
 * /news/{slug}/ … slug がカテゴリ(src/data/site.ts の COLLECTIONS.news.terms)ならカテゴリ一覧、
 * それ以外は記事詳細。記事のスラッグにカテゴリと同じ文字列は使わないこと(カテゴリ一覧が優先される)。
 */
import { getEmDashEntry } from "emdash";
import ArchivePage from "../../components/ArchivePage.astro";
import DetailPage from "../../components/DetailPage.astro";
import { COLLECTIONS } from "../../data/site";

const { slug } = Astro.params;
if (!slug) return Astro.rewrite("/404/");
const isTerm = COLLECTIONS.news.terms.some((t) => t.slug === slug);

let entry: any = null;
if (!isTerm) {
	const res = await getEmDashEntry("news", slug);
	if (res.error) console.error("[news] 記事の取得に失敗", res.error);
	if (!res.entry) return Astro.rewrite("/404/");
	if (Astro.cache?.enabled && res.cacheHint) Astro.cache.set(res.cacheHint);
	entry = res.entry;
}
---
{isTerm ? <ArchivePage collection="news" term={slug} /> : <DetailPage collection="news" slug={slug} entry={entry} />}
