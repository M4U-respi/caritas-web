---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionHead from "../components/SectionHead.astro";
import Partners from "../components/Partners.astro";
import { env } from "cloudflare:workers";

/** Cloudflare Turnstile のサイトキー(wrangler.jsonc の vars) */
const turnstileSiteKey = (env as { TURNSTILE_SITE_KEY?: string }).TURNSTILE_SITE_KEY;

const lead = "寄付や募金のお手続き、資料のご請求、取材のお申し込みなど、お気軽にお問い合わせください。";
---
<Layout title="お問い合わせ" bodyClass="page-contact" description={lead}>
	<PageHeader title="お問い合わせ" en="CONTACT" ja="ご連絡" lead={lead} />

	<!-- お電話・FAX -->
	<section class="sub-section contact-tel" aria-labelledby="tel-title">
		<div class="l-container">
			<SectionHead en="PHONE / FAX" id="tel-title" lead="お急ぎの場合や、フォームの入力が難しい場合は、こちらへご連絡ください。">
				<Fragment slot="title"><em class="u-red">お電話・FAX</em>での<br class="u-sp-only" />お問い合わせ</Fragment>
			</SectionHead>
			<div class="tel-box">
				<dl class="tel-box__grid">
					<div class="tel-card">
						<dt class="tel-card__label"><img src="/assets/img/sub/contact/icon-tel.png" alt="" width="18" height="20" />電話</dt>
						<dd class="tel-card__num"><a href="tel:0356324439">03-5632-4439</a></dd>
					</div>
					<div class="tel-card">
						<dt class="tel-card__label"><img src="/assets/img/sub/contact/icon-fax.png" alt="" width="26" height="26" />FAX</dt>
						<dd class="tel-card__num">03-5632-4464</dd>
					</div>
					<div class="tel-card tel-card--wide">
						<dt class="tel-card__label">所在地</dt>
						<dd class="tel-card__addr">
							<address>〒135-8585<span class="u-sp"></span>東京都江東区潮見2-10-10<span class="u-sp"></span>日本カトリック会館6F<br />宗教法人カトリック中央協議会 カリタスジャパン</address>
						</dd>
					</div>
				</dl>
				<!-- TODO(要確認): 受付時間の正式文言(カンプの「※ 受付時間は事務局にご確認のうえ記載してください。」は編集用メモのため非表示) -->
			</div>
		</div>
		<svg class="curve curve--up contact-tel__curve" viewBox="0 0 1440 42" preserveAspectRatio="none" aria-hidden="true"><path d="M0 42 Q720 -42 1440 42 Z" fill="currentColor" /></svg>
	</section>

	<!-- フォーム -->
	<section class="sub-section sub-section--cream-light contact-form-section" id="form" aria-labelledby="form-title">
		<div class="l-container">
			<SectionHead en="CONTACT FORM" title="フォームでのお問い合わせ" id="form-title" lead="いただいた内容には、事務局より順次ご返信いたします。お急ぎの場合はお電話をご利用ください。" />
			<div class="form-card">
				<ol class="form-steps" aria-label="お問い合わせの手順">
					<li class="form-steps__item" aria-current="step"><span class="form-steps__num">1</span>お問い合わせ入力</li>
					<li class="form-steps__item"><span class="form-steps__num">2</span>内容確認</li>
					<li class="form-steps__item"><span class="form-steps__num">3</span>送信完了</li>
				</ol>
				<!-- TODO(要確認): 送信先未定。確認・完了画面のカンプなし -->
				<form class="form-body" id="contact-form" action="/api/contact" method="post" novalidate>
					<!-- 迷惑送信対策(人には見えない欄。入力があれば破棄) -->
					<p class="visually-hidden" aria-hidden="true"><label>空欄のままにしてください<input type="text" name="hp_note" tabindex="-1" autocomplete="off" /></label></p>
					<div class="form-row">
						<label class="form-row__label" for="cf-name">お名前<span class="form-badge form-badge--req">必須</span></label>
						<div>
							<input class="form-input" id="cf-name" name="name" type="text" maxlength="100" autocomplete="name" placeholder="例: 鈴木 一郎" required aria-describedby="cf-name-err" />
							<p class="form-error" id="cf-name-err" aria-live="polite"></p>
						</div>
					</div>
					<div class="form-row">
						<label class="form-row__label" for="cf-email">メールアドレス<span class="form-badge form-badge--req">必須</span></label>
						<div>
							<input class="form-input" id="cf-email" name="email" type="email" maxlength="254" autocomplete="email" inputmode="email" placeholder="例: example@caritas.jp" required aria-describedby="cf-email-help cf-email-err" />
							<p class="form-help" id="cf-email-help">ご返信先としてお使いします。</p>
							<p class="form-error" id="cf-email-err" aria-live="polite"></p>
						</div>
					</div>
					<div class="form-row">
						<label class="form-row__label" for="cf-subject">ご用件<span class="form-badge form-badge--opt">任意</span></label>
						<div><input class="form-input" id="cf-subject" name="subject" type="text" maxlength="200" placeholder="例: 資料の請求について" /></div>
					</div>
					<div class="form-row form-row--textarea">
						<label class="form-row__label" for="cf-message">メッセージ本文<span class="form-badge form-badge--req">必須</span></label>
						<div>
							<textarea class="form-input" id="cf-message" name="message" rows="4" maxlength="10000" placeholder="お問い合わせの内容をご記入ください。" required aria-describedby="cf-message-err"></textarea>
							<p class="form-error" id="cf-message-err" aria-live="polite"></p>
						</div>
					</div>

					<div class="form-agree">
						<label class="form-check">
							<input type="checkbox" name="agree" id="cf-agree" required aria-describedby="cf-agree-err" />
							<span><a href="/privacy-policy/" target="_blank" rel="noopener">プライバシーポリシー</a>に同意する</span>
						</label>
						<p class="form-error" id="cf-agree-err" aria-live="polite"></p>
						<p class="sub-note">ご記入いただいた個人情報は、お問い合わせへの対応にのみ使用します。詳しくはプライバシーポリシーをご覧ください。</p>
					</div>

					{turnstileSiteKey && <div class="form-turnstile cf-turnstile" data-sitekey={turnstileSiteKey} data-action="contact" data-language="ja" data-theme="light"></div>}
					<button class="form-submit" type="submit"><span>入力内容を確認する</span><svg width="6" height="10" aria-hidden="true"><use href="#i-chevron" /></svg></button>
					<p class="form-status" id="cf-status" role="status" hidden></p>
					<p class="sub-note note-hang">※ 迷惑行為を防ぐため、Cloudflare Turnstile を使用しています。プライバシーポリシーもあわせてご確認ください。</p>
				</form>

				<!-- 2. 内容確認 -->
				<div class="form-body form-confirm" id="cf-confirm" hidden>
					<dl id="cf-confirm-list"></dl>
					<div class="form-actions">
						<button class="form-back" type="button" id="cf-back">入力内容を修正する</button>
						<button class="form-submit" type="button" id="cf-send"><span>この内容で送信する</span><svg width="6" height="10" aria-hidden="true"><use href="#i-chevron" /></svg></button>
					</div>
					<p class="form-status" id="cf-send-status" role="status" hidden></p>
				</div>

				<!-- 3. 送信完了 -->
				<div class="form-body form-done" id="cf-done" tabindex="-1" hidden>
					<p class="form-done__title">お問い合わせを送信しました。</p>
					<p class="sub-text">内容を確認のうえ、事務局より順次ご返信いたします。</p>
				</div>
			</div>
		</div>
	</section>

	<Partners />
	{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</Layout>

<script>
	/* お問い合わせフォーム:入力チェック → 内容確認 → 送信(/api/contact)→ 完了 */
	const form = document.getElementById("contact-form") as HTMLFormElement | null;
	if (form) {
		const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
		const status = $<HTMLParagraphElement>("cf-status");
		const confirmBox = $<HTMLDivElement>("cf-confirm");
		const confirmList = $<HTMLDListElement>("cf-confirm-list");
		const sendBtn = $<HTMLButtonElement>("cf-send");
		const sendStatus = $<HTMLParagraphElement>("cf-send-status");
		const done = $<HTMLDivElement>("cf-done");
		const steps = [...document.querySelectorAll<HTMLLIElement>(".form-steps__item")];

		const setStep = (n: number) => steps.forEach((li, i) => (i === n ? li.setAttribute("aria-current", "step") : li.removeAttribute("aria-current")));
		const show = (el: HTMLElement) => {
			[form, confirmBox, done].forEach((x) => (x.hidden = x !== el));
			el.closest(".form-card")?.scrollIntoView({ behavior: "smooth", block: "start" });
		};

		// TODO(要確認): エラー文言
		const checks: [string, string, (el: HTMLInputElement) => string][] = [
			["cf-name", "cf-name-err", (el) => (el.value.trim() ? "" : "お名前を入力してください。")],
			["cf-email", "cf-email-err", (el) => (!el.value.trim() ? "メールアドレスを入力してください。" : el.validity.typeMismatch ? "メールアドレスの形式が正しくありません。" : "")],
			["cf-message", "cf-message-err", (el) => (el.value.trim() ? "" : "メッセージ本文を入力してください。")],
			["cf-agree", "cf-agree-err", (el) => (el.checked ? "" : "プライバシーポリシーへの同意が必要です。")],
		];
		const validate = (id: string, errId: string, fn: (el: HTMLInputElement) => string) => {
			const el = $<HTMLInputElement>(id);
			const msg = fn(el);
			$(errId).textContent = msg;
			if (msg) el.setAttribute("aria-invalid", "true");
			else el.removeAttribute("aria-invalid");
			return !msg;
		};
		checks.forEach(([id, errId, fn]) => {
			const el = $<HTMLInputElement>(id);
			el.addEventListener(el.type === "checkbox" ? "change" : "blur", () => validate(id, errId, fn));
		});

		// 1 → 2:入力チェックを通ったら確認画面へ
		form.addEventListener("submit", (e) => {
			e.preventDefault();
			const results = checks.map(([id, errId, fn]) => validate(id, errId, fn));
			const firstNg = results.indexOf(false);
			if (firstNg >= 0) {
				status.hidden = true;
				$(checks[firstNg][0]).focus();
				return;
			}
			const val = (id: string) => $<HTMLInputElement>(id).value.trim();
			const rows: [string, string][] = [
				["お名前", val("cf-name")],
				["メールアドレス", val("cf-email")],
				["ご用件", val("cf-subject") || "(未記入)"],
				["メッセージ本文", val("cf-message")],
			];
			confirmList.replaceChildren(
				...rows.map(([label, value]) => {
					const row = document.createElement("div");
					row.className = "form-row";
					const dt = document.createElement("dt");
					dt.className = "form-row__label";
					dt.textContent = label;
					const dd = document.createElement("dd");
					dd.className = "form-confirm__value";
					dd.textContent = value;
					row.appendChild(dt);
					row.appendChild(dd);
					return row;
				}),
			);
			sendStatus.hidden = true;
			setStep(1);
			show(confirmBox);
		});

		// 2 → 1:修正
		$("cf-back").addEventListener("click", () => {
			setStep(0);
			show(form);
		});

		// 2 → 3:送信
		sendBtn.addEventListener("click", async () => {
			sendBtn.disabled = true;
			sendStatus.hidden = true;
			try {
				const res = await fetch(form.action, { method: "POST", body: new FormData(form) });
				const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
				if (!res.ok || !data.ok) throw new Error(data.error || String(res.status));
				form.reset();
				(window as { turnstile?: { reset(): void } }).turnstile?.reset();
				setStep(2);
				show(done);
				done.focus({ preventScroll: true });
			} catch (err) {
				(window as { turnstile?: { reset(): void } }).turnstile?.reset();
				sendStatus.textContent = String(err).includes("turnstile") ? "認証の有効期限が切れたため送信できませんでした。お手数ですが「入力内容を修正する」から認証をやり直してください。" : "送信できませんでした。時間をおいて再度お試しいただくか、お電話・FAX でお問い合わせください。";
				sendStatus.hidden = false;
			} finally {
				sendBtn.disabled = false;
			}
		});
	}
</script>
