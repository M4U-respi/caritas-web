---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import SectionHead from "../../components/SectionHead.astro";
import FlowCards from "../../components/FlowCards.astro";
import DonateNotice from "../../components/DonateNotice.astro";
import Faq from "../../components/Faq.astro";
import RelatedNav from "../../components/RelatedNav.astro";
import Partners from "../../components/Partners.astro";
import { CARD_AMOUNTS } from "../../data/donate";

const lead = "お手元のクレジットカードで、一回かぎりの寄付ができます。金額と支援先をお選びいただき、その場で手続きが完了します。";

const flow = [
	{ title: "金額を選ぶ", text: "下の金額からお選びください。選ぶと、決済サービスの受付ページへ移動します。<span class=\"flow__mark\">*</span>" },
	{ title: "カード情報を入力する", text: "決済サービスの画面で、カード情報をご入力ください。" },
	{ title: "備考欄にご意向を書く", text: "領収証をご希望の方、匿名をご希望の方は、支払い画面の備考欄にその旨をご記入ください。" },
	{ title: "完了", text: "手続きが終わると、ご入力いただいたメールアドレスに受付完了のお知らせが届きます。" },
];

const notice = [
	{ th: "領収書", td: "ご希望の方は、支払い画面の備考欄にその旨をご記入ください。発行までおよそ1か月かかります。" },
	{ th: "匿名でのご支援", td: "献金者名簿への氏名の掲載を控えたい場合も、備考欄にご記入ください。" },
	// TODO(要確認): 対応ブランドが決まったら差し替え(カンプの文言のまま)
	{ th: "ご利用いただけるカード", td: "実装時に決済サービスの対応ブランドを掲載します。" },
	{ th: "継続してのご支援", td: "毎月のご支援をご希望の場合は、マンスリーサポーターをご覧ください。" },
	// TODO(要確認): カンプの文言のまま(サービス提供元への確認事項を含む)
	{ th: "決済サービスについて", td: "決済は外部サービス（payment.alij.ne.jp）を利用しています。対応ブランド、手数料、任意金額の指定可否、デザインのカスタマイズ範囲は、サービス提供元への確認が必要です。" },
];

const faq = [
	{ q: "カードの情報はどこに入力しますか。", a: "カリタスジャパンのサイトではなく、外部の決済サービスのページで入力していただきます。金額をお選びいただくと、そのページへ移動します。", open: true },
	{ q: "金額は自由に決められますか。", a: "現在の決済サービスでは、1,000円・2,000円・3,000円・5,000円・10,000円・30,000円・50,000円の中からお選びいただく形になります。" },
	{ q: "領収書を発行してもらえますか。", a: "ご希望の方は、支払い画面の備考欄にその旨をご記入ください。発行までおよそ1か月かかります。" },
	{ q: "手続きが終わったことはどう分かりますか。", a: "手続きが終わると、ご入力いただいたメールアドレスに受付完了のお知らせが届きます。" },
	{ q: "毎月続けて寄付したい場合はどうすればよいですか。", a: "マンスリーサポーターをご利用ください。お申し込みには申込書のご提出が必要で、クレジットカードでのお手続きではありません。" },
];
---
<Layout title="クレジットカードで寄付する" description={lead}>
	<PageHeader title="クレジットカードで寄付する" en="CREDIT CARD" ja="カード寄付" lead={lead} crumbs={[{ label: "寄付する", href: "/donate/" }]} />

	<!-- お手続きの流れ -->
	<section class="sub-section donate-card" aria-labelledby="flow-title">
		<div class="l-container">
			<SectionHead en="FLOW" id="flow-title" class="sub-head--lg">
				<Fragment slot="title">お手続きの<em class="u-red">流れ</em></Fragment>
			</SectionHead>
			<FlowCards items={flow} />

			<div class="amounts" id="amount">
				<h3 class="subheading-bar">金額を選ぶ</h3>
				<!-- TODO(要確認): 各金額の決済ページ URL(src/data/donate.ts の CARD_AMOUNTS) -->
				<ul class="amounts__list">
					{CARD_AMOUNTS.map((a) => (
						<li><a class="amounts__btn" href={a.href} data-todo={a.href === "#" ? "url" : undefined} rel="noopener"><span class="amounts__num">{a.amount.toLocaleString("ja-JP")}</span><span class="amounts__unit">円</span></a></li>
					))}
				</ul>
				<p class="sub-note note-hang amounts__note">※ 現在の決済サービスでは、上記の金額からお選びいただく形になります。</p>
			</div>

			<div class="external-note">
				<p class="external-note__title">*外部のページへ移動します</p>
				<p class="external-note__text">寄付の受付は、決済サービスのページ（カリタスジャパンのサイトとは別のアドレス）で行います。お名前やカード情報の入力も、そちらのページで行っていただきます。</p>
			</div>
		</div>
	</section>

	<!-- ご確認いただきたいこと -->
	<DonateNotice rows={notice} />

	<!-- よくあるご質問 -->
	<section class="sub-section sub-section--cream faq-section faq-section--lg" aria-labelledby="faq-title">
		<div class="l-container">
			<SectionHead en="FAQ" title="よくあるご質問" id="faq-title" class="sub-head--lg" />
			<Faq items={faq} />
		</div>
		<svg class="curve curve--down sub-section__curve-down" viewBox="0 0 1440 42" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0 Q720 84 1440 0 Z" fill="currentColor" /></svg>
	</section>

	<RelatedNav preset="donate" />
	<Partners class="partners--after-nav" />
</Layout>
