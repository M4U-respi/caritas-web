---
import { getEmDashEntry } from "emdash";
import DetailPage from "../../components/DetailPage.astro";

const { slug } = Astro.params;
if (!slug) return Astro.rewrite("/404/");
const { entry, cacheHint, error } = await getEmDashEntry("report", slug);
if (error) console.error("[report] 記事の取得に失敗", error);
if (!entry) return Astro.rewrite("/404/");
if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);
---
<DetailPage collection="report" slug={slug} entry={entry} />
