---
/*
 * /publication/{slug}/ … slug がカテゴリ(src/data/site.ts の COLLECTIONS.publication.terms)ならカテゴリ一覧。
 * 発行物は一覧(カテゴリでの絞り込み)のみで、個別ページは作らない(それ以外の slug は 404)。
 * 404 の判定はレスポンス開始前に行う必要があるため、データ取得はここ(ページ)で行う。
 */
import ArchivePage from "../../components/ArchivePage.astro";
import { COLLECTIONS } from "../../data/site";
import { loadArchive } from "../../lib/cms";

const { slug } = Astro.params;
if (!slug) return Astro.rewrite("/404/");
const isTerm = COLLECTIONS.publication.terms.some((t) => t.slug === slug);

if (!isTerm) return Astro.rewrite("/404/");
const archive = await loadArchive("publication", Astro.url, { term: slug, cache: Astro.cache });
if (!archive) return Astro.rewrite("/404/");
---
<ArchivePage collection="publication" term={slug} data={archive} />
