---
/*
 * /publication/{slug}/ … slug がカテゴリ(src/data/site.ts の COLLECTIONS.publication.terms)ならカテゴリ一覧、
 * それ以外は記事詳細。記事のスラッグにカテゴリと同じ文字列は使わないこと(カテゴリ一覧が優先される)。
 * 404 の判定はレスポンス開始前に行う必要があるため、データ取得はここ(ページ)で行う。
 */
import { getEmDashEntry } from "emdash";
import ArchivePage from "../../components/ArchivePage.astro";
import DetailPage from "../../components/DetailPage.astro";
import { COLLECTIONS } from "../../data/site";
import { getAdjacentEntries, loadArchive } from "../../lib/cms";

const { slug } = Astro.params;
if (!slug) return Astro.rewrite("/404/");
const isTerm = COLLECTIONS.publication.terms.some((t) => t.slug === slug);

let archive = null;
let entry: any = null;
let adjacent = null;
if (isTerm) {
	archive = await loadArchive("publication", Astro.url, { term: slug, cache: Astro.cache });
	if (!archive) return Astro.rewrite("/404/");
} else {
	const res = await getEmDashEntry("publication", slug);
	if (res.error) console.error("[publication] 記事の取得に失敗", res.error);
	if (!res.entry) return Astro.rewrite("/404/");
	if (Astro.cache?.enabled && res.cacheHint) Astro.cache.set(res.cacheHint);
	entry = res.entry;
	adjacent = await getAdjacentEntries("publication", entry);
}
---
{archive ? <ArchivePage collection="publication" term={slug} data={archive} /> : <DetailPage collection="publication" slug={slug} entry={entry} adjacent={adjacent!} />}
