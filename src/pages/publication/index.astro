---
import ArchivePage from "../../components/ArchivePage.astro";
import { loadArchive } from "../../lib/cms";

// 一覧(?page=n)。存在しないページ番号は 404
const data = await loadArchive("publication", Astro.url, { cache: Astro.cache });
if (!data) return Astro.rewrite("/404/");
---
<ArchivePage collection="publication" data={data} />
