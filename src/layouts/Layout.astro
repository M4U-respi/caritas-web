---
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, absUrl, canonicalPath } from "../data/site";
import { buildGraph, type FaqItem, type PageType } from "../lib/seo";
import { toJsonLd } from "../lib/jsonld";

interface Props {
	/** ページ名(未指定ならサイト既定タイトル) */
	title?: string;
	description?: string | null;
	image?: string | null;
	/** <head> に追加する preload 画像 */
	preloadImage?: string;
	/** スマホ用に別画像を先読みする場合(preloadImage は 768px 以上だけになる) */
	preloadImageSp?: string;
	/** CMSコンテンツページの場合に指定 */
	content?: { collection: string; id: string; slug?: string | null };
	bodyClass?: string;
	/** 構造化データのページ種別(既定は WebPage) */
	pageType?: PageType;
	/** pageType="Article" のとき、記事ごとの公開日・更新日(ISO 文字列) */
	article?: { datePublished?: string | null; dateModified?: string | null };
	/** 本文に表示している FAQ。表示していないものを渡さないこと(構造化データだけの申告は不可) */
	faq?: FaqItem[];
	/** canonical に残すクエリ(一覧のページ送り・年の絞り込み。例 "?page=2") */
	canonicalQuery?: string;
	/** robots(例 "noindex, nofollow")。既定は出力しない=index,follow */
	robots?: string;
	/** 表示しているパンくずがあるか(既定は TOP 以外 true) */
	hasBreadcrumb?: boolean;
}

const {
	title,
	description,
	image,
	preloadImage,
	preloadImageSp,
	content,
	bodyClass,
	pageType = "WebPage",
	article,
	faq,
	canonicalQuery = "",
	robots,
	hasBreadcrumb,
} = Astro.props;
/* 団体名を後ろに付ける。ただし title にすでに「カリタスジャパン」が入っているページには付けない */
const fullTitle = !title ? SITE.defaultTitle : title.includes(SITE.name) ? title : `${title}｜${SITE.titleSuffix}`;
const pageDescription = description ?? SITE.description;
/** SNS 共有用の画像(未指定のページはサイト共通の OGP 画像。トップの写真+ロゴ、1200×630) */
const pageImage = image || absUrl("/assets/img/ogp.jpg");
/** ページの URL(本番ドメイン + 末尾スラッシュをそろえたパス)。パンくずの `@id` の元 */
const pageUrl = absUrl(canonicalPath(Astro.url.pathname));
/** 正規 URL(+ 一覧のページ送り・年の絞り込み) */
const canonical = pageUrl + canonicalQuery;
const showBreadcrumb = hasBreadcrumb ?? Astro.url.pathname !== "/";

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: title ?? SITE.defaultTitle,
	description: pageDescription,
	image: pageImage,
	/* 正規 URL(クエリを除く)。EmDashHead が canonical・og:url として出力する */
	canonical,
	content,
	/*
	 * siteName はあえて渡さない。渡すと EmDash が og:site_name のほかに
	 * 素の WebSite の JSON-LD も出し、下の @graph の WebSite と二重になるため。
	 * og:site_name・og:locale はこの下で自前で出す。
	 */
	...(robots ? { seo: { robots } } : {}),
});

/* 構造化データ(@graph)。記事ごとの SEO 設定(管理画面)で noindex にしたページでは出さない */
const graphJson = toJsonLd(
	buildGraph({
		url: canonical,
		pageUrl,
		title: fullTitle,
		headline: title ?? SITE.defaultTitle,
		description: pageDescription,
		image: pageImage,
		type: pageType,
		hasBreadcrumb: showBreadcrumb,
		article,
		faq,
	}),
);
---
<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="format-detection" content="telephone=no" />
		<!-- og:site_name・og:locale は EmDashHead が出さないぶんをここで補う(上の pageCtx のコメント参照) -->
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:locale" content="ja_JP" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&family=Noto+Serif+JP:wght@400;500;600;700&display=swap" rel="stylesheet" />
		{preloadImage && <link rel="preload" as="image" href={preloadImage} media={preloadImageSp ? "(min-width: 768px)" : undefined} />}
		{preloadImageSp && <link rel="preload" as="image" href={preloadImageSp} media="(max-width: 767.98px)" />}
		<link rel="stylesheet" href={`/assets/css/style.css?v=${__ASSET_VER__}`} />
		<link rel="stylesheet" href={`/assets/css/pages.css?v=${__ASSET_VER__}`} />
		<script is:inline>
			/* JS 有効時のみ .js を付与。main.js が読めない場合は外してコンテンツを必ず表示する */
			(function (d) { d.classList.add("js"); setTimeout(function () { if (!window.__caritasReady) d.classList.remove("js"); }, 4000); })(document.documentElement);
			/* 他ページからのアンカーリンク:ブラウザの即ジャンプを止め、ページ先頭からアンカーまでスムーススクロール(戻る/進む・再読み込み・動きを減らす設定では通常どおり) */
			(function () {
				var hash = location.hash, nav = performance.getEntriesByType && performance.getEntriesByType("navigation")[0];
				if (!hash || hash.length < 2 || (nav && nav.type !== "navigate") || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
				var url = location.pathname + location.search;
				history.replaceState(history.state, "", url);
				window.addEventListener("load", function () {
					var id; try { id = decodeURIComponent(hash.slice(1)); } catch (e) { id = hash.slice(1); }
					var target = document.getElementById(id);
					history.replaceState(history.state, "", url + hash);
					if (!target) return;
					window.scrollTo({ top: 0, behavior: "instant" });
					setTimeout(function () { target.scrollIntoView({ behavior: "smooth", block: "start" }); }, 300);
				});
			})();
		</script>
		<EmDashHead page={pageCtx} />
		<!-- 構造化データ(JSON-LD)。組み立ては src/lib/seo.ts、エスケープは src/lib/jsonld.ts -->
		<script type="application/ld+json" set:html={graphJson} />
	</head>
	<body class={bodyClass}>
		<EmDashBodyStart page={pageCtx} />

		<svg class="svg-sprite" aria-hidden="true" focusable="false" width="0" height="0">
			<symbol id="i-chevron" viewBox="0 0 8 12"><path d="M1.5 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" /></symbol>
			<symbol id="i-heart" viewBox="0 0 24 24"><path fill="currentColor" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" /></symbol>
			<symbol id="i-download" viewBox="0 0 14 14"><path d="M7 1.5v7M4 5.8 7 8.8l3-3M1.5 9.5v3h11v-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></symbol>
			<symbol id="i-phone" viewBox="0 0 24 24"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8z" /></symbol>
			<symbol id="i-globe" viewBox="0 0 16 16"><g fill="none" stroke="#4FA8D8" stroke-width="1"><circle cx="8" cy="8" r="7" /><ellipse cx="8" cy="8" rx="3" ry="7" /><path d="M1 8h14M2.2 4.5h11.6M2.2 11.5h11.6" /></g></symbol>
		</svg>

		<a class="skip-link" href="#main">本文へスキップ</a>

		<Header />

		<main id="main">
			<slot />
		</main>

		<Footer />

		<!-- 画面下に固定の寄付ボタン(〜1099px) -->
		<a class="fixed-donate" href="/donate/">
			<svg class="fixed-donate__heart" width="20" height="20" aria-hidden="true"><use href="#i-heart" /></svg>
			<span>寄付で支援する</span>
			<svg class="fixed-donate__chevron" width="7" height="12" aria-hidden="true"><use href="#i-chevron" /></svg>
		</a>

		<script is:inline src={`/assets/js/main.js?v=${__ASSET_VER__}`} defer onerror="document.documentElement.classList.remove('js')"></script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
