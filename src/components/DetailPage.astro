---
/*
 * CMS 記事の詳細ページ(白背景+パンくず → タイトル・日付・タグ → 本文 → 前後記事 → 一覧へ戻る)
 * entry・前後記事はページ側(src/pages/{news,report,publication}/[slug].astro)で取得して渡す(404 判定をレスポンス開始前に行うため)。
 * 発行物もお知らせと同じ構成(PDF などのダウンロードは本文内のリンクから)。
 */
import { getEntryTerms } from "emdash";
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "./Breadcrumb.astro";
import PostNav from "./PostNav.astro";
import Prose from "./prose/Prose.astro";
import Donation from "./Donation.astro";
import RelatedNav from "./RelatedNav.astro";
import Partners from "./Partners.astro";
import { COLLECTIONS, formatDate, isoDate, type CollectionKey } from "../data/site";

interface Link { href: string; title: string }
interface Props {
	collection: CollectionKey;
	slug: string;
	entry: any;
	adjacent: { prev: Link | null; next: Link | null };
}
const { collection, slug, entry, adjacent } = Astro.props;
const conf = COLLECTIONS[collection];

const d: any = entry.data;
const terms = ((await getEntryTerms(collection, d.id, conf.taxonomy)) ?? []) as any[];
const date = d.publishedAt ?? d.createdAt;
const termTags = terms.map((t) => ({
	href: `${conf.base}${t.slug}/`,
	label: t.label,
	tag: conf.terms.find((x) => x.slug === t.slug)?.tag ?? "blue",
}));
// お知らせのうち発行物(We are Caritas など)は、発行物の分類タグも表示する
if (collection === "news") {
	const pub = COLLECTIONS.publication;
	const pubTerms = ((await getEntryTerms("news", d.id, pub.taxonomy)) ?? []) as any[];
	for (const t of pubTerms) termTags.push({ href: `${pub.base}${t.slug}/`, label: t.label, tag: pub.terms.find((x) => x.slug === t.slug)?.tag ?? "blue" });
}
const related = collection === "news" ? "news" : collection === "publication" ? "publication" : null;
const ogImage = (d.featured_image ?? d.cover)?.src;
---
<Layout title={d.title} description={d.excerpt} image={ogImage && /^https?:/.test(ogImage) ? ogImage : ogImage ? new URL(ogImage, Astro.url).href : undefined} content={{ collection, id: d.id, slug }}>
	<Breadcrumb items={[{ label: conf.label, href: conf.base }, { label: d.title }]} />

	<article class="article">
		<div class="article__inner">
			<header class="article__head">
				<h1 class="article__title" {...entry.edit?.title}>{d.title}</h1>
				<p class="article__meta">
					{date && <time class="article__date" datetime={isoDate(date)}>{formatDate(date)}</time>}
					{termTags.map((t) => <a class={`tag tag--${t.tag}`} href={t.href}>{t.label}</a>)}
				</p>
			</header>

			<Prose value={d.content} lead={d.lead} />

			<div class="article__foot">
				<PostNav prev={adjacent.prev} next={adjacent.next} />
				<p class="article__back">
					<a class="btn-outline btn-outline--sm" href={conf.base}><span>{conf.label}一覧へ</span><svg class="btn-outline__chevron" width="6" height="10" aria-hidden="true"><use href="#i-chevron" /></svg></a>
				</p>
			</div>
		</div>
	</article>

	<Donation />
	{related && <RelatedNav preset={related} />}
	<Partners class={related ? "partners--after-nav" : undefined} />
</Layout>
