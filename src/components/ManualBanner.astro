---
/* 災害対応マニュアル(緑セクション)。/about/aid/ と /report/ で共通 */
import GreenSection from "./GreenSection.astro";
import CircleArrow from "./CircleArrow.astro";
---
<GreenSection class="manual" labelledby="manual-title">
	<div class="manual__inner">
		<header class="manual__head">
			<p class="section-label" lang="en">MANUAL</p>
			<h2 class="heading-lg manual__title" id="manual-title">災害対応マニュアル</h2>
		</header>
		<!-- TODO(要確認): リンク先(PDF ダウンロードか別ページか)未支給 -->
		<a class="manual__card" href="#" data-todo="url">
			<span class="manual__card-body">
				<span class="manual__card-title">「災害対応マニュアル」付属のCDに入っているデータ集</span>
				<span class="manual__card-text">災害が起きたとき、教区・小教区でどのように動くかをまとめた手引きです。<br class="u-pc-only" />平時の備えから、発災直後の初動、中長期の復興支援までを扱っています。</span>
			</span>
			<CircleArrow />
		</a>
	</div>
</GreenSection>
