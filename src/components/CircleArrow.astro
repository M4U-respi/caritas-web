---
/* 赤丸矢印(直径 24px)。dir="left" で左向き */
interface Props { dir?: "right" | "left"; class?: string }
const { dir = "right", class: cls } = Astro.props;
---
<span class:list={["circle-arrow", dir === "left" && "circle-arrow--left", cls]} aria-hidden="true"><svg width="6" height="9"><use href="#i-chevron" /></svg></span>
