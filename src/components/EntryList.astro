---
import type { ListItem } from "../lib/cms";
import { formatDate, isoDate } from "../data/site";
interface Props {
	items: ListItem[];
	variant?: "default" | "urgent";
	/** カテゴリタグを表示するか */
	showTags?: boolean;
	class?: string;
}
const { items, variant = "default", showTags = true, class: cls } = Astro.props;
---
<ul class:list={["news-list", `news-list--${variant}`, cls]}>
	{items.map((item) => (
		<li class="news-list__item">
			<a class="news-list__link" href={item.href}>
				<span class="news-list__meta">
					<time class="news-list__date" datetime={isoDate(item.date)}>{formatDate(item.date)}</time>
					{showTags && item.terms.map((t) => <span class={`tag tag--${t.tag}`}>{t.label}</span>)}
				</span>
				<span class="news-list__title">{item.title}</span>
				<svg class="news-list__chevron" width="6" height="10" aria-hidden="true"><use href="#i-chevron" /></svg>
			</a>
		</li>
	))}
</ul>
