---
/*
 * 写真帯+アーチ(下辺に白の上膨らみカーブ)。about ヒーロー下 / social 活動セクション下
 *   <PhotoStrip gap="cream" photos={[{ src: "/assets/img/…", alt: "…", width: 714, height: 800 }, …]} />
 * gap: 写真の隙間の色(上のセクションの色)"cream" | "green" | "white"
 */
interface Photo { src: string; alt: string; width: number; height: number; /** トリミング位置(object-position。省略時は中央) */ pos?: string; /** 拡大率(デザインのトリミングが cover より寄っているとき。pos を中心に拡大) */ zoom?: number }
interface Props { photos: Photo[]; gap?: "cream" | "green" | "white" }
const { photos, gap = "cream" } = Astro.props;
---
<div class:list={["photo-strip", "photo-strip--arch-bottom", `photo-strip--gap-${gap}`]}>
	<ul class="photo-strip__list">
		{photos.map((p) => (
			<li class="photo-strip__item"><img src={p.src} alt={p.alt} width={p.width} height={p.height} loading="lazy" decoding="async" style={[p.pos && `object-position: ${p.pos}`, p.zoom && `transform: scale(${p.zoom}); transform-origin: ${p.pos ?? "50% 50%"}`].filter(Boolean).join("; ") || undefined} /></li>
		))}
	</ul>
	<svg class="curve curve--up photo-strip__curve" viewBox="0 0 1440 42" preserveAspectRatio="none" aria-hidden="true"><path d="M0 42 Q720 -42 1440 42 Z" fill="currentColor" /></svg>
</div>
