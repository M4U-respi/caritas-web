---
/*
 * パンくず。先頭の「ホーム」は自動で付く。最後の項目が現在地(リンクなし・aria-current)。
 * items: [{ label: "カリタスジャパンとは", href: "/about/" }, { label: "援助活動" }]
 */
import { SITE, absUrl, canonicalPath } from "../data/site";
import { toJsonLd } from "../lib/jsonld";
import { breadcrumbId } from "../lib/seo";

export interface Crumb { label: string; href?: string }
interface Props { items: Crumb[]; class?: string }
const { items, class: cls } = Astro.props;
const list: Crumb[] = [{ label: "ホーム", href: "/" }, ...items];
const last = list.length - 1;

/* URL は本番ドメイン基準の絶対 URL。`@id` は Layout の @graph の WebPage から参照される */
const current = absUrl(canonicalPath(Astro.url.pathname));
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"@id": breadcrumbId(current),
	itemListElement: list.map((c, i) => ({
		"@type": "ListItem",
		position: i + 1,
		name: i === 0 ? SITE.name : c.label,
		...(c.href ? { item: absUrl(c.href) } : i === last ? { item: current } : {}),
	})),
};
// 構造化データ(JSON-LD)。エスケープは src/lib/jsonld.ts
const ldJson = toJsonLd(jsonLd);
---
<nav class:list={["breadcrumb", cls]} aria-label="パンくずリスト">
	<ol class="breadcrumb__list">
		{list.map((c, i) => (
			<li class="breadcrumb__item">
				{i < last && c.href ? <a href={c.href}>{c.label}</a> : <span aria-current={i === last ? "page" : undefined}>{c.label}</span>}
			</li>
		))}
	</ol>
	<script type="application/ld+json" set:html={ldJson} />
</nav>
